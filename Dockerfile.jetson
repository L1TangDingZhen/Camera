FROM nvcr.io/nvidia/l4t-pytorch:r35.2.1-pth2.0-py3

LABEL maintainer="Life Tracker Team"
LABEL version="1.0.1-jetson-mediapipe"

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1

WORKDIR /app

# Install system dependencies in smaller steps
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    cmake \
    git \
    wget \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Install OpenCV dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    libopencv-dev \
    python3-opencv \
    && rm -rf /var/lib/apt/lists/*

# Install other dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    libopenblas-dev \
    libjpeg-dev \
    zlib1g-dev \
    nano \
    htop \
    && rm -rf /var/lib/apt/lists/*

# Upgrade pip
RUN python3 -m pip install --upgrade pip setuptools wheel

# Copy and install Python requirements
COPY requirements_jetson.txt /app/
RUN pip3 install --no-cache-dir -r requirements_jetson.txt

# Copy application code
COPY . /app/

# Create directories
RUN mkdir -p /app/data /app/logs /app/models /app/config

# Download YOLO models
RUN cd /app/models && \
    wget -q https://github.com/ultralytics/assets/releases/download/v0.0.0/yolov8n.pt || true && \
    wget -q https://github.com/ultralytics/assets/releases/download/v0.0.0/yolov8s.pt || true && \
    wget -q https://github.com/ultralytics/assets/releases/download/v0.0.0/yolov8m.pt || true

# Set permissions
RUN chmod +x /app/*.sh 2>/dev/null || true

EXPOSE 5000

CMD ["python3", "main.py", "--config", "config/config_jetson_balanced.yaml"]
